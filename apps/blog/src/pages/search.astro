---
import Base from '../layouts/Base.astro';

// Pagefind's component UI is about 180 KB, so it loads only on this page, not site-wide.
---

<Base title="Search" description="Search every post and project.">
  <link slot="head" rel="stylesheet" href="/pagefind/pagefind-component-ui.css" />
  <h1>Search</h1>
  {
    import.meta.env.DEV && (
      <p class="muted">
        The search index is generated by <code>npm run build</code>, so search doesn't work in the dev server.
        Use <code>npm run preview:blog</code> after a build.
      </p>
    )
  }
  <div class="search">
    <pagefind-input></pagefind-input>
    <pagefind-summary></pagefind-summary>
    <pagefind-results></pagefind-results>
  </div>
  <noscript><p>Search needs JavaScript. Every post is also listed on the <a href="/posts/">posts page</a>.</p></noscript>
  <!-- A plain file from /pagefind/, so the CSP allows it through 'self' with no hash or inline code. -->
  <script is:inline type="module" src="/pagefind/pagefind-component-ui.js"></script>
</Base>
